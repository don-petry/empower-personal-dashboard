# Empower Personal Dashboard Credentials (Optional - can also be passed via CLI or interactive prompt)
EMPOWER_USERNAME=user@example.com
EMPOWER_PASSWORD=your_password_here
EMPOWER_SESSION_FILE=~/.empower_personal_dashboard_session.json
# Verbose debug logging (logs HTTP requests/responses — sensitive).
# Enable with 1/true/yes/on; any falsy value (0/false/no/off) or unset = off.
EMPOWER_DEBUG=0
